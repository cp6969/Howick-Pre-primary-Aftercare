# Copy this file to .env and fill in real values before running the app.

# Site-wide login — the one shared username/password all aftercare staff use.
# Generate the hash with:
#   node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
APP_USERNAME=
APP_PASSWORD_HASH=

# Random long string used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-this-to-a-long-random-string

# Port the Node server listens on
PORT=3000

# Set to "production" once running behind HTTPS (a reverse proxy / Cloudflare
# Tunnel) so session cookies get the "secure" flag. Leave unset for local testing.
NODE_ENV=production
