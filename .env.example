# Copy this file to .env and fill in real values before running the app.

# Site-wide login — the one shared username/password all aftercare staff use.
# Generate the hash with:
#   node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
APP_USERNAME=
APP_PASSWORD_HASH=

# Admin PIN -- a second gate on top of the site login, for /admin.html
# (billing rates, per-child attendance history/tally). Generate the hash
# the same way as APP_PASSWORD_HASH above, just with a PIN instead of a
# password:
#   node -e "console.log(require('bcryptjs').hashSync('your-pin', 10))"
ADMIN_PIN_HASH=

# Random long string used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-this-to-a-long-random-string

# Port the Node server listens on
PORT=3000

# Set to "production" once running behind HTTPS (a reverse proxy / Cloudflare
# Tunnel) so session cookies get the "secure" flag. Leave unset for local testing.
NODE_ENV=production

# Only needed if you're using the optional "cloudflared" service in
# docker-compose.yml for a public URL. Create a tunnel in the Cloudflare Zero
# Trust dashboard (Networks > Tunnels > Create a tunnel > Cloudflared) and
# paste the token it gives you. Leave blank for LAN-only access.
TUNNEL_TOKEN=

# Only needed for the "email today's log automatically" feature (Settings
# page). Who receives it, what time it sends, and on/off are all set from
# the Settings page itself -- these are just the SMTP server credentials.
# Leave blank to leave that feature unusable (it fails safe: /api/daily-log/status
# reports smtp_configured: false and the Settings page explains why, nothing
# crashes).
#
# Example for Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587,
# SMTP_USER=you@gmail.com, SMTP_PASS=<a 16-character Gmail "App Password",
# not your normal Gmail password -- Google requires this for SMTP login>.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Defaults to SMTP_USER if left blank.
SMTP_FROM=
